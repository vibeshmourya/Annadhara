# Annadhara Server Environment Configuration (Team Seva Shakti — MERNOVA X 2026)
PORT=5000
NODE_ENV=development

# MongoDB Connection
# If local MongoDB is running, use: mongodb://127.0.0.1:27017/foodbridge
# If MongoDB is not running locally, the server automatically starts an in-memory MongoDB instance for development!
MONGODB_URI=mongodb://127.0.0.1:27017/foodbridge

# JWT Secret & Expiration
JWT_SECRET=foodbridge_super_secret_jwt_key_2026_shared_hope_zero_waste
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (comma separated)
CLIENT_URL=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Admin default credentials (for seed initialization)
ADMIN_EMAIL=admin@foodbridge.org
ADMIN_PASSWORD=Admin@123

