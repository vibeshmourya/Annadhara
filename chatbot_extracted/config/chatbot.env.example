# ==============================================================================
# Annadhara AI Assistant — Environment Variables
# Team Seva Shakti | MERNOVA X 2026
# ==============================================================================
# Add these variables to your Annadhara server's `.env` file (e.g. `server/.env`).
# DO NOT commit real API keys to version control.

# ------------------------------------------------------------------------------
# 1. Groq Cloud LLM Inference Configuration (Required for live chat completion)
# ------------------------------------------------------------------------------
# Free API key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# LLM Model ID on Groq Cloud
# Recommended options:
# - llama-3.3-70b-versatile  (Recommended high quality)
# - llama-3.1-8b-instant     (Ultra-fast, lowest latency)
# - qwen/qwen3.8-27b         (Multilingual reasoning)
# - mixtral-8x7b-32768       (Long context)
GROQ_MODEL=llama-3.3-70b-versatile

# Upstream request timeout in milliseconds (default: 15000)
GROQ_TIMEOUT=15000

# Maximum output tokens generated per assistant response (default: 512 - 1024)
AI_MAX_TOKENS=1024

# Sliding window rate limit: maximum messages per minute per user (default: 20-30)
AI_RATE_LIMIT=30


# ------------------------------------------------------------------------------
# 2. Tavily Web Search Configuration (Optional — Real-time FSSAI / regulatory search)
# ------------------------------------------------------------------------------
# Free API key from https://tavily.com (1,000 free searches/month)
# If omitted or left empty, the assistant seamlessly falls back to curated
# official Indian food safety regulatory data (FSSAI / Eat Right India).
TAVILY_API_KEY=your_tavily_api_key_here

# Maximum external search citations returned per query (default: 3-5)
TAVILY_MAX_RESULTS=5

# Search depth: 'basic' (fast, credit-efficient) or 'advanced'
TAVILY_SEARCH_DEPTH=basic

# Search timeout in milliseconds (default: 8000)
TAVILY_TIMEOUT=8000
