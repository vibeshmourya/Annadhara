# ==============================================================================
# Annadhara Web Client — Environment Configuration
# Team Seva Shakti | MERNOVA X 2026
# ==============================================================================

# 1. Local Development (default):
# In local development, the Vite dev server automatically proxies /api -> http://localhost:5000:
VITE_API_BASE_URL=/api

# 2. Production Deployment on Vercel:
# Set this in your Vercel Frontend Project Settings -> Environment Variables:
# Provide the deployed backend Vercel URL (with or without /api; both are automatically handled):
# VITE_API_BASE_URL=https://<your-backend-project>.vercel.app/api

# Supported aliases (Vite automatically accepts any of these):
# VITE_API_URL=https://<your-backend-project>.vercel.app/api
# VITE_BACKEND_URL=https://<your-backend-project>.vercel.app
