{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://annadhara-i83w.vercel.app/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://annadhara-i83w.vercel.app/uploads/$1"
    },
    {
      "source": "/((?!api/|uploads/).*)",
      "destination": "/index.html"
    }
  ]
}

