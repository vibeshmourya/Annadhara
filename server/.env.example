# ==============================================================================
# Annadhara Backend Server — Environment Configuration
# Team Seva Shakti | MERNOVA X 2026
# ==============================================================================

# Server Network Port
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# MongoDB Database Connection
# ------------------------------------------------------------------------------
# MongoDB Atlas (Cloud Database — Recommended):
# 1. Log in to MongoDB Atlas (https://www.mongodb.com/cloud/atlas)
# 2. In Network Access, whitelist your IP address (or 0.0.0.0/0 for development)
# 3. In Database Access, create a database user and password
# 4. In Clusters -> Connect -> Drivers -> copy your connection string
# Replace <username>, <password>, and <cluster-url> with your credentials:
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/annadhara?retryWrites=true&w=majority

# Optional alias (MONGODB_URI takes precedence if both are set):
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/annadhara?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# Security & JWT Configuration
# ------------------------------------------------------------------------------
# Generate a secure 64-character random string for production
JWT_SECRET=your_super_secret_jwt_key_here_change_for_production
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# CORS Allowed Client Origins (Comma-separated)
# ------------------------------------------------------------------------------
CLIENT_URL=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# Initial Demo Admin Credentials (Optional / Seed)
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@foodbridge.org
ADMIN_PASSWORD=Admin@123
